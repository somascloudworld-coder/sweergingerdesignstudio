# Sweet Ginger Design Studio - environment
#
# Copy to .env.local for LOCAL development. Never commit .env.local.
#
# ============================================================================
# READ THIS BEFORE SETTING VARIABLES ON A DEPLOYED HOST (Vercel, Netlify, ...)
#
# A deployed host has no writable, persistent disk, so DATA_BACKEND must NOT be
# "local" there. If it is, the studio shows a setup screen explaining exactly that
# instead of silently losing every design and order.
#
#   DATA_BACKEND=supabase
#   NEXT_PUBLIC_SUPABASE_URL=...
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
#   SUPABASE_SERVICE_ROLE_KEY=...        <- server-side only, never NEXT_PUBLIC_
#
# Scope those to ALL environments (Production AND Preview), or a Preview deployment
# will not receive them. Environment variables are read at build time, so a redeploy
# is required after any change.
#
# Then open  /api/health  on the deployment: it reports which backend was selected,
# which variables actually reached the process, and whether the database answered.
# ============================================================================

# --- Local development (default) -------------------------------------------
# SQLite at .data/studio.db, created and seeded automatically on first run.
DATA_BACKEND=local

# --- Supabase (the production path) ----------------------------------------
# Paste from: Supabase dashboard -> Project Settings -> API
#
# 1. Project URL            -> Project Settings -> API -> Project URL
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#
# 2. Publishable / anon key -> Project Settings -> API -> publishable (or anon) key
#    Safe in the browser; RLS allows it to read nothing.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# 3. Service-role key       -> Project Settings -> API -> service_role (reveal)
#    SERVER ONLY. Bypasses RLS. Never expose, never prefix NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=...

# --- Staff session signing (optional; a random secret is generated if unset) -
# STAFF_SESSION_SECRET=a-long-random-string

# --- Print export (placeholders until D4 supplies real print-floor specs) ----
# PRINT_DPI=300
