# Sweet Ginger Design Studio - environment
#
# Two data backends are supported behind one repository interface:
#
#   DATA_BACKEND=local      (default) A local SQLite file at .data/studio.db.
#                           Auto-created and seeded on first use. This is what
#                           the build was verified against on this machine.
#
#   DATA_BACKEND=supabase   The Tech Stack's managed Postgres. Requires the three
#                           variables below. Run supabase-setup.sql in the
#                           Supabase SQL editor first.
#
# No secret key is ever exposed to the browser: only NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are public. The service-role key is read
# server-side only and is never sent to a client.

DATA_BACKEND=local

# --- Supabase (only when DATA_BACKEND=supabase) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-side-only

# --- Staff session signing (generates an ephemeral secret if unset) ---
# STAFF_SESSION_SECRET=a-long-random-string

# --- Print export (placeholders until D4 supplies real print-floor specs) ---
# PRINT_DPI=300
# PRINT_SAFE_MARGIN_PX=0
